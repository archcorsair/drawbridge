<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.archcorsair.drawbridged</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/drawbridged</string>
		<string>-agent</string>
		<string>auto</string>
		<string>-vm</string>
		<string>drawbridge</string>
		<string>-secret-file</string>
		<string>/Users/dev/Library/Application Support/drawbridge/transport-secret-lima-drawbridge</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/Library/Logs/drawbridge/drawbridged.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/drawbridge/drawbridged.log</string>
</dict>
</plist>
